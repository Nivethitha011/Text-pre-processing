import pandas as pd
import re

# -----------------------------
# Create Raw Dataset
# -----------------------------
data = {
    "id": [1, 2, 3, 4, 5],
    "text": [
        "I love Python programming! Visit https://python.org #Python @user123",
        "Machine Learning is amazing. Contact: ml@gmail.com #AI",
        "Today's weather is 32°C!!! Visit www.weather.com for updates.",
        "Follow @OpenAI for AI news. #Technology #Innovation 2026",
        "Data Science + NLP = Future!!! Email: data123@test.com 😊"
    ]
}

df = pd.DataFrame(data)

# -----------------------------
# Save Raw CSV
# -----------------------------
df.to_csv("raw_data.csv", index=False)

# Read CSV
df = pd.read_csv("raw_data.csv")

print("========== RAW DATA ==========")
print(df)

# -----------------------------
# Lowercase & Uppercase
# -----------------------------
df["lower_text"] = df["text"].str.lower()
df["upper_text"] = df["text"].str.upper()

# -----------------------------
# Regex Functions
# -----------------------------
sample = df.loc[0, "text"]

print("\n========== ORIGINAL TEXT ==========")
print(sample)

# findall() - URLs
print("\nURL Found:")
print(re.findall(r'https?://\S+|www\.\S+', sample))

# findall() - Hashtags
print("\nHashtags:")
print(re.findall(r'#\w+', sample))

# search()
if re.search("Python", sample, re.IGNORECASE):
    print("\nSearch Result: Python Found")
else:
    print("\nPython Not Found")

# split()
print("\nSplit Result:")
print(re.split(r'\s+', sample))

# -----------------------------
# Cleaning Function
# -----------------------------
def clean_text(text):

    # Convert to lowercase
    text = text.lower()

    # Remove URLs
    text = re.sub(r'https?://\S+|www\.\S+', '', text)

    # Remove Emails
    text = re.sub(r'\S+@\S+', '', text)

    # Remove Mentions
    text = re.sub(r'@\w+', '', text)

    # Remove Hashtags
    text = re.sub(r'#\w+', '', text)

    # Remove Numbers
    text = re.sub(r'\d+', '', text)

    # Remove Special Characters & Emojis
    text = re.sub(r'[^a-zA-Z\s]', '', text)

    # Remove Extra Spaces
    text = re.sub(r'\s+', ' ', text).strip()

    return text

# -----------------------------
# Apply Cleaning
# -----------------------------
df["cleaned_text"] = df["text"].apply(clean_text)

print("\n========== CLEANED DATA ==========")
print(df)

# -----------------------------
# Save Cleaned CSV
# -----------------------------
df.to_csv("cleaned_data.csv", index=False)

print("\nCleaning Completed Successfully!")
print("Files Created:")
print("1. raw_data.csv")
print("2. cleaned_data.csv")
